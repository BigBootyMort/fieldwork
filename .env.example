# Fieldwork environment configuration
# Copy this file to `.env` and fill in your values.

# Neo4j password — MUST be changed for any non-throwaway use.
# Generate one with: openssl rand -hex 24
NEO4J_PASSWORD=changeme_dev_only

# Claude API key — powers ALL AI features across both backends (shell news brief,
# markets/reports analysis, agent, gigs, presence; legacy investigation/vision/summaries).
# Without it, the shell falls back to the local Ollama model (weaker). Accepts a normal
# API key (sk-ant-api…) or a subscription OAuth token from `claude setup-token`
# (sk-ant-oat…). Alternatively set it in the Agent ⚙ Settings UI, or run the host
# Claude Code bridge (shell/host-bridge/start-claude-bridge.bat) to use your subscription
# without a key. See docs/kb/llm-engines.md.
ANTHROPIC_API_KEY=

# Optional API keys for crawlers. Leave blank to disable that crawler.

# OpenCorporates — corporate registries
# Sign up: https://opencorporates.com/api_accounts/new
OPENCORPORATES_TOKEN=

# GitHub — public profile and repo data
# Generate at: https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# NewsAPI — recent news mentions
# Sign up: https://newsapi.org/register
NEWS_API_KEY=

# SEC EDGAR — required User-Agent per SEC fair-use policy
# Format: "Tool Name contact@youremail.com"  (must include contact info)
SEC_USER_AGENT=Fieldwork OSINT research@fieldwork.local

# Shodan — IP/host intelligence (open ports, banners, org, ASN, vulns)
# Free tier: 100 credits/month (1 credit per host lookup)
# Sign up: https://account.shodan.io/register
SHODAN_API_KEY=

# VirusTotal — domain/IP reputation + passive DNS history
# Free tier: 500 lookups/day, 4/minute
# Sign up: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# OCCRP Aleph — investigative journalism + court/corporate records across 130+ jurisdictions
# Free account: https://aleph.occrp.org  → Settings → API key
# Works without a key (lower rate limit), but a key is recommended
ALEPH_API_KEY=

# SauceNAO — reverse image search (server-side, returns similarity matches)
# Free: 100 searches/day without key, 150/day with free account key
# Register: https://saucenao.com/user.php?page=register
# Without a key the endpoint still works via browser-link fallback
SAUCENAO_KEY=

# ── Phase 4: NLP pipeline ─────────────────────────────────────────────────────

# LibreTranslate — self-hosted translation (opt-in, see docker-compose.yml)
# Start with: docker compose --profile translation up -d
# Leave blank to use the default internal URL. Backend skips translation
# gracefully if the service is not running.
LIBRETRANSLATE_URL=

# ── Phase 6: New data sources ─────────────────────────────────────────────────

# OpenSky Network — aircraft flight history
# Free account at https://opensky-network.org (needed for historical data)
# Without credentials: live data only, no history
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# HaveIBeenPwned — email breach check
# ~$3.50/month at https://haveibeenpwned.com/API/Key
# Domain breach check (no key needed) always works
HIBP_API_KEY=

# Arkham Intelligence — crypto wallet entity mapping
# Free tier at https://arkhamintelligence.com
ARKHAM_API_KEY=
